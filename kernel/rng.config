# The guest driver for virtio-rnd.
#
# fastboot.config leaves hwrng out entirely, so the device enumerates
# and nothing binds to it. Paired with the VMM giving virtio-rnd a PCI
# class: without both halves the device is inert.
#
# Any workload doing TLS wants this.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
