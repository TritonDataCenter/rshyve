# More than one vCPU.
#
# fastboot.config pins CONFIG_SMP=n and NR_CPUS=1, which is right for a
# one-shot payload and a hard ceiling for a pod. Separated from
# container.config so the AP-bringup cost can be attributed on its own.
CONFIG_SMP=y
CONFIG_NR_CPUS=8

# Depends on SMP, so it cannot live in container.config.
CONFIG_CPUSETS=y
