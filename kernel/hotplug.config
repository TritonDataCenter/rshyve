# Guest support for ACPI disk, CPU and memory hotplug.
#
# Pairs with the VMM's GPE0 block and the PHPR / PRES / MHPC register
# files. Without both halves the guest sees the hotplug AML but has no
# driver to act on a Notify.
#
# Self-contained: it sets SMP itself, because CPU hotplug has no meaning
# without it. Do not layer smp.config as well, or NR_CPUS depends on
# fragment order.
#
# fastboot.config turns all of this off to keep the one-shot payload
# small, so every option here is an override of an explicit "is not set".

# ── SMP, and the CPU hotplug it enables ─────────────────────────
# HOTPLUG_CPU is def_bool y under SMP, and arch/x86/Kconfig then does
# "select ACPI_HOTPLUG_CPU if ACPI_PROCESSOR && HOTPLUG_CPU". Both are
# listed so build.sh fails loudly if either select stops firing.
# CPUSETS is deliberately absent: it needs CGROUPS, which only
# container.config turns on, and CPU hotplug does not use it.
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_HOTPLUG_CPU=y
CONFIG_ACPI_HOTPLUG_CPU=y

# ── PCI hotplug, ACPI flavour ───────────────────────────────────
# acpiphp binds the per-slot _EJ0 / _SUN nodes. The native SHPC and
# PCIe flavours cannot work on a flat i440fx bus.
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y
# Names the slots in /sys/bus/pci/slots, which is how a test asserts a
# slot arrived rather than polling lspci.
CONFIG_ACPI_PCI_SLOT=y

# ── Memory hotplug ──────────────────────────────────────────────
# SPARSEMEM and SPARSEMEM_VMEMMAP are already on in fastboot.config,
# and x86_64 selects ARCH_ENABLE_MEMORY_HOTPLUG.
CONFIG_MEMORY_HOTPLUG=y
# Without this a hot-added DIMM stays offline and the guest reports no
# extra memory, which reads as a VMM failure.
CONFIG_MEMORY_HOTPLUG_DEFAULT_ONLINE=y
CONFIG_ACPI_HOTPLUG_MEMORY=y
CONFIG_MIGRATION=y
CONFIG_MEMORY_HOTREMOVE=y

# ── Container and module devices ────────────────────────────────
# PNP0A06 is the _HID the PHPR, PRES and MHPC controller nodes use.
CONFIG_ACPI_CONTAINER=y
