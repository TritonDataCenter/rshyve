# Kernel support a container workload expects.
#
# fastboot.config is tuned for one static payload in a microVM and turns
# all of this off. A pod sandbox needs it: the containers inside get one
# namespace set each, cgroups account them, and netfilter is what a
# service mesh and kube-proxy rewrite.
#
# Layered on fastboot.config. Measure the boot cost before adopting.

# ── Namespaces: one set per container inside the sandbox ────────
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# ── cgroups: v2 accounting and limits ───────────────────────────
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
# CONFIG_CPUSETS lives in smp.config: it depends on SMP, and
# olddefconfig drops it silently on a uniprocessor kernel.

# ── netfilter: iptables and nftables ────────────────────────────
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# ── Container networking ────────────────────────────────────────
CONFIG_VETH=y
CONFIG_BRIDGE=y

# ── Sandboxing and keyrings ─────────────────────────────────────
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y
