# rust-bhyve fast-boot kernel config
# Target: sub-125ms boot to init on bhyve with direct kernel boot
# Based on Linux 6.12.x, stripped to the minimum
#
# Build: kernel/build.sh, which appends this file to tinyconfig

# ── Architecture ─────────────────────────────────────────────────
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_SMP=n
CONFIG_NR_CPUS=1
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# PVH entry point, the x86/HVM direct boot ABI. Adds the
# XEN_ELFNOTE_PHYS32_ENTRY note to vmlinux, which lets a VMM enter the
# kernel in 32-bit protected mode and skip the real-mode boot stub and
# the self-decompression step. The bzImage keeps its own entry point
# and is unaffected.
CONFIG_PVH=y

# ── General setup ────────────────────────────────────────────────
CONFIG_LOCALVERSION="-fastboot"
CONFIG_DEFAULT_HOSTNAME="vmm"
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Disable heavyweight subsystems
# CONFIG_MODULES is not set
# CONFIG_MODULE_UNLOAD is not set
# CONFIG_AUDIT is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_SCHED_AUTOGROUP is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_BLK_DEV_BSGLIB is not set
# CONFIG_BLK_DEBUG_FS is not set
# CONFIG_COMPAT_32BIT_TIME is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
# CONFIG_PERF_EVENTS is not set

# ── Memory ───────────────────────────────────────────────────────
CONFIG_MMU=y
CONFIG_SPARSEMEM=y
CONFIG_SPARSEMEM_VMEMMAP=y
CONFIG_COMPACTION=y
CONFIG_TRANSPARENT_HUGEPAGE=y
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_KSM is not set
# CONFIG_KFENCE is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_PAGE_POISONING is not set

# ── Timers ───────────────────────────────────────────────────────
CONFIG_HZ_100=y
CONFIG_HZ=100
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HPET_TIMER=y
CONFIG_X86_TSC=y
CONFIG_X86_PMTIMER=y

# ── PCI ──────────────────────────────────────────────────────────
CONFIG_PCI=y
CONFIG_PCI_DOMAINS=y
# CONFIG_PCIEPORTBUS is not set
# CONFIG_PCIEASPM is not set
# CONFIG_PCI_IOV is not set
# CONFIG_HOTPLUG_PCI is not set

# ── ACPI (minimal) ──────────────────────────────────────────────
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_DOCK is not set
# CONFIG_ACPI_DEBUG is not set
# CONFIG_ACPI_PCI_SLOT is not set
# CONFIG_ACPI_HOTPLUG_CPU is not set

# ── Block layer ──────────────────────────────────────────────────
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_CDROM is not set
# CONFIG_BLK_DEV_MD is not set
# CONFIG_BLK_DEV_DM is not set

# ── VirtIO (all static, no modules) ─────────────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_VIRTIO_MMIO is not set

# ── NVMe ────────────────────────────────────────────────────────
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# ── SCSI (needed by some virtio paths) ──────────────────────────
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_SCSI_DMA is not set

# ── Serial / TTY ────────────────────────────────────────────────
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
# CONFIG_SERIAL_8250_EXTENDED is not set
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

# ── Filesystems ─────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_EXT2_FS is not set
# CONFIG_EXT3_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_NTFS3_FS is not set

# ── Networking (minimal, enough for virtio-net) ─────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_NET_9P is not set

# ── Disable everything else ─────────────────────────────────────
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_SERIO_I8042 is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_HID is not set
# CONFIG_FB is not set
# CONFIG_DRM is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_GPIO_SYSFS is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_ACCESSIBILITY is not set
# CONFIG_INFINIBAND is not set
# CONFIG_EDAC is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_DMADEVICES is not set
# CONFIG_AUXDISPLAY is not set
# CONFIG_VHOST is not set
# CONFIG_STAGING is not set
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_PM_DEVFREQ is not set
# CONFIG_NVMEM is not set
# CONFIG_FIRMWARE_MEMMAP is not set

# ── Security (disabled) ─────────────────────────────────────────
# CONFIG_SECURITY is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_LANDLOCK is not set
# CONFIG_INTEGRITY is not set
# CONFIG_KEYS is not set
# CONFIG_ENCRYPTED_KEYS is not set
# CONFIG_TRUSTED_KEYS is not set
# CONFIG_CRYPTO_USER is not set

# ── Crypto (minimal, only what the kernel core needs) ───────────
CONFIG_CRYPTO=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32=y
# CONFIG_CRYPTO_USER_API is not set
# CONFIG_CRYPTO_MANAGER_DISABLE_TESTS is not set

# ── Binary formats (required to exec anything) ─────────────────
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ── EFI (disabled: the VMM boots the kernel directly) ───────────
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# CONFIG_EFI_MIXED is not set

# ── Kernel compression ──────────────────────────────────────────
CONFIG_KERNEL_GZIP=y

# ── initramfs ────────────────────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
