# The guest driver for virtio-vsock.
#
# Paired with the VMM's device: without both halves the guest has no
# AF_VSOCK address family and nothing binds to the PCI device.
#
# This is the channel a CRI agent needs. Unlike virtio-console it
# multiplexes, so exec, attach, logs and stats can be in flight at once.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
