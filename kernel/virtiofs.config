# Overlay fragment for the virtio-fs test kernel.
#
# Layered on fastboot.config by:
#   KERNEL_EXTRA_CONFIG=virtiofs.config KERNEL_OUT_SUFFIX=-virtiofs ./build.sh
#
# Kept out of fastboot.config so the boot-time benchmarks keep comparing
# against the same kernel.

# virtio-fs needs FUSE. VIRTIO_FS has no DAX here: the device exposes no
# shared-memory window, so every reply travels through the request queue.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# A container image is mounted read-only and given a tmpfs upper layer,
# so the guest can write without touching the host export.
CONFIG_OVERLAY_FS=y
